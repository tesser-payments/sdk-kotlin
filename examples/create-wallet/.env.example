# Tesser Kotlin SDK — examples/create-wallet
#
# Copy this file to `.env.local` (gitignored) and fill in real values:
#   cp .env.example .env.local
#
# Then source it before running the example:
#   set -a && source .env.local && set +a
#   ./gradlew :examples:create-wallet:run
#
# (Alternatives: `direnv`, `dotenv-cli`, IntelliJ run-configuration env vars.)

# --- Tesser API ---

# Base URL for the Tesser API (the host that serves /v1/accounts/wallets etc.).
# Use the staging/sandbox URL while testing; switch to prod for production.
API_BASE_URL=https://staging.tesser.xyz

# OAuth token endpoint. NOTE: this is a SEPARATE host from API_BASE_URL — Tesser
# hosts the OAuth /oauth/token endpoint on a dedicated auth subdomain. Ask Tesser
# support for the exact URL for your environment if you don't have it.
# Production default per spec section 7.8: https://auth.tesser.xyz/oauth/token
AUTH_TOKEN_URL=https://auth.tesser.xyz/oauth/token

# OAuth audience parameter. Per spec section 7.8, this defaults to API_BASE_URL
# if left blank — Tesser's auth provider expects the API base URL as the audience.
# Override only if Tesser support directs you to a different value (rare).
API_AUDIENCE=

# OAuth client_credentials issued by Tesser.
# Get from: Tesser dashboard → Settings → API Credentials
API_CLIENT_ID=
API_CLIENT_SECRET=

# --- Turnkey signing key ---
#
# These come from your Turnkey API key registration. The Tesser dashboard surfaces
# them under Settings → Signing Keys, or your Turnkey console under API Keys.
#
# IMPORTANT key-format rules:
#   - publicKey is the 33-byte COMPRESSED P-256 (secp256r1) point in hex
#     - 66 chars total, prefix '02' or '03'
#     - The SDK does NOT auto-compress — supply the canonical form Turnkey stored
#   - privateKey is the raw 32-byte P-256 scalar in hex (64 chars)
#   - enclaveId is your Turnkey sub-organization ID (looks like 'org_...')

SIGNING_PUBLIC_KEY=
SIGNING_PRIVATE_KEY=
SIGNING_ENCLAVE_ID=

# --- Wallet to create ---

# One of: stablecoin_ethereum | stablecoin_solana | stablecoin_stellar
# v0.0.1 verified end-to-end against Tesser staging only for stablecoin_ethereum;
# Solana/Stellar account specs are best-guesses pending their first staging run.
CREATE_WALLET_TYPE=stablecoin_ethereum
