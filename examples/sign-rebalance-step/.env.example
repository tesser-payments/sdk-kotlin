# Tesser Kotlin SDK, examples/sign-rebalance-step
#
# Copy this file to `.env.local` (gitignored) and fill in real values:
#   cp .env.example .env.local
#
# Then source it before running the example:
#   set -a && source .env.local && set +a
#   ./gradlew :examples:sign-rebalance-step:run
#
# Alternatives: `direnv` (see ../../.envrc.example), `dotenv-cli`,
# or IntelliJ run-configuration env vars.

# --- Tesser API ---

# Base URL for the Tesser API (the host that serves /v1/treasury/rebalances).
API_BASE_URL=https://staging.tesser.xyz

# OAuth token endpoint. NOTE: this is a SEPARATE host from API_BASE_URL.
AUTH_TOKEN_URL=https://auth.tesser.xyz/oauth/token

# OAuth audience parameter. Defaults to API_BASE_URL if left blank.
API_AUDIENCE=

# OAuth client_credentials issued by Tesser.
# Get from the Tesser dashboard, under Settings, then API Credentials.
API_CLIENT_ID=
API_CLIENT_SECRET=

# --- Signing key ---
#
# Same format as examples/create-wallet/.env.example. See that file for the
# field-format rules.

SIGNING_PUBLIC_KEY=
SIGNING_PRIVATE_KEY=
SIGNING_ENCLAVE_ID=

# --- Webhook listener ---

# The publicly-reachable URL that points to this example's webhook listener.
# You provide this by running a tunnel:
#   cloudflared tunnel --url http://localhost:8787
# The tunnel command prints the public https://....trycloudflare.com URL.
# Register `<that URL>/webhook` in the Tesser dashboard for the
# `step.signature_requested` event before running this example.
WEBHOOK_PUBLIC_URL=

# Local port the embedded webhook server listens on. Default 8787.
WEBHOOK_PORT=8787

# Webhook signing secret from the Tesser dashboard. Used to verify the
# signature header on every incoming webhook before the payload is trusted.
WEBHOOK_SECRET=

# --- Rebalance: what to move ---

# Source account.
FROM_ACCOUNT_ID=
FROM_AMOUNT=
FROM_CURRENCY=
# Optional, used only for wallet sources.
FROM_NETWORK=

# Destination account.
TO_ACCOUNT_ID=
TO_CURRENCY=
# Optional, used only for wallet destinations.
TO_NETWORK=
